{
  "name": "recallweaver-dsh",
  "version": "1.2.1",
  "description": "RecallWeaver long-term memory integration for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bridge.py",
    "cordis.patch.yml"
  ],
  "scripts": {
    "install:python": "python -m pip install recallweaver==1.2.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "recallweaver",
    "memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "pythonDependencies": {
      "recallweaver": "==1.2.1"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://registry.npmjs.org/recallweaver-dsh/-/recallweaver-dsh-1.2.1.tgz",
      "zip": "https://github.com/gaoweimax/recallweaver/archive/refs/heads/main.zip",
      "git": "https://github.com/gaoweimax/recallweaver.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
